{
    "Rules": [
        {
            "ID": "RawDataLifecycle",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "raw/"
            },
            "Transitions": [
                {
                    "Days": 90,
                    "StorageClass": "STANDARD_IA"
                },
                {
                    "Days": 180,
                    "StorageClass": "GLACIER"
                },
                {
                    "Days": 365,
                    "StorageClass": "DEEP_ARCHIVE"
                }
            ]
        },
        {
            "ID": "ProcessedDataLifecycle",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "processed/"
            },
            "Transitions": [
                {
                    "Days": 180,
                    "StorageClass": "STANDARD_IA"
                },
                {
                    "Days": 365,
                    "StorageClass": "GLACIER"
                }
            ]
        },
        {
            "ID": "FinalDataLifecycle",
            "Status": "Enabled",
            "Filter": {
                "Prefix": "final/"
            },
            "Transitions": [
                {
                    "Days": 365,
                    "StorageClass": "STANDARD_IA"
                }
            ]
        }
    ]
}